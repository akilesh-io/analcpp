#!/bin/lua



local compile = os.execute("g++ app/main.cpp -o main")

if compile ~= true and compile ~= 0 then
    print("Compilation failed!")
    os.exit(1)
end
local run = os.execute("./main")
if run ~= true and run ~= 0 then
    os.exit(1)
end

function fact(n)
  if n == 0 then
    return 1
  else
    return n * fact(n -1)
  end
end
